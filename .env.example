# ============================================================================
# SMART GROCERY TRACKER - ENVIRONMENT VARIABLES CONFIGURATION EXAMPLE
# Copy this file to .env and adjust values for your environment
# ============================================================================

# Application Server Port
PORT=3000

# Server Host ('0.0.0.0' allows access from phones & tablets in same Wi-Fi)
HOST=0.0.0.0

# Optional: Supabase Online Cloud Database & Authentication
# If left blank, the application automatically uses the persistent backend database in ./data/database.json
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Session Security Secret (Used for signing authentication tokens)
SESSION_SECRET=super_secret_grocery_token_salt_key_change_in_production
